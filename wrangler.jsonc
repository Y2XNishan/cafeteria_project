{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-02-23",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafeteria-production",
      "database_id": "local-dev-only"
    }
  ],
  "vars": {
    "JWT_SECRET": "smartcafe-super-secure-production-jwt-token-key-2026",
    "ENVIRONMENT": "production"
  }
}
